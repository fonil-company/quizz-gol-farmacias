# Copie este arquivo para ".env" e preencha antes de gerar o build.
# Atenção: toda variável VITE_ fica visível no navegador. Nunca coloque tokens ou senhas aqui.

# WhatsApp comercial oficial: DDI + DDD + número, somente dígitos. Ex.: 5562999999999
VITE_WHATSAPP_NUMBER=

# Endpoint do webhook que recebe o lead em JSON (CRM, Make, n8n, Zapier...).
# Vazio = modo demonstração (nada é enviado e a página avisa isso).
VITE_WEBHOOK_URL=

# Link da Política de Privacidade
VITE_PRIVACY_URL=
