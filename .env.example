# Copie este arquivo para ".env" e preencha antes de gerar o build.
# Atenção: toda variável VITE_ fica visível no navegador. Nunca coloque tokens ou senhas aqui.

# WhatsApp comercial oficial: DDI + DDD + número, somente dígitos. Ex.: 5562999999999
VITE_WHATSAPP_NUMBER=

# Endpoint do webhook que recebe o lead em JSON (CRM, Make, n8n, Zapier...).
# Vazio = modo demonstração (nada é enviado e a página avisa isso).
VITE_WEBHOOK_URL=

# Link da Política de Privacidade
VITE_PRIVACY_URL=

# ID do Meta Pixel (Gerenciador de Eventos). Ativa o Pixel e a API de Conversões.
VITE_META_PIXEL_ID=

# --- Somente no servidor (sem VITE_): nunca vão para o navegador ---
# Token da API de Conversões. No EasyPanel, cadastre em Environment, nunca no repositório.
META_ACCESS_TOKEN=
# URL do webhook do CRM (com token). Use VITE_WEBHOOK_URL=/api/lead para o lead passar pelo servidor.
LEAD_WEBHOOK_URL=
# Opcional: código da aba "Testar eventos" do Gerenciador de Eventos
META_TEST_EVENT_CODE=
