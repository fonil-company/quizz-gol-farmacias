# Configuração usada no build de produção (npm run build).
# Atenção: toda variável VITE_ fica visível no navegador. Nunca coloque tokens ou senhas aqui.

# WhatsApp do consultor comercial: +55 86 9984-0542
VITE_WHATSAPP_NUMBER=558699840542

# Rota do servidor da página que repassa o lead ao CRM (o endereço real fica em LEAD_WEBHOOK_URL, no EasyPanel).
# Vazio = modo demonstração (nada é enviado e a página avisa isso).
VITE_WEBHOOK_URL=/api/lead

# Link da Política de Privacidade
VITE_PRIVACY_URL=

# ID do Meta Pixel (Gerenciador de Eventos). Ativa o Pixel e a API de Conversões.
VITE_META_PIXEL_ID=2155316585266232
